###--- ключ KMS ---###
# Симметричный ключ, которым Object Storage шифрует объекты на своей стороне (server-side encryption).
# Сам ключ наружу не выдаётся: Object Storage обращается к KMS от имени того, кто читает или пишет объект,
# поэтому этому аккаунту кроме прав на бакет нужны права на ключ (см. iam.tf).
#
# ⚠️ Удаление ключа равносильно потере всех зашифрованных им объектов.
resource "yandex_kms_symmetric_key" "bucket" {
  name              = var.kms_key_name
  description       = "Шифрование содержимого бакета ${var.bucket_name}"
  default_algorithm = "AES_256"
  # Раз в год создаётся новая версия ключа и становится основной. Прежние версии сохраняются,
  # поэтому объекты, зашифрованные ими, продолжают расшифровываться.
  rotation_period = "8760h"
}
